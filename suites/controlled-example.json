{
  "id": "json-contract-controlled-smoke",
  "name": "JSON 契约两题受控冒烟套件",
  "description": "复用公开示例前两题，验证普通 eval 的受控执行链路；两题不足以判定 skill 有效。",
  "version": "1",
  "skill": {
    "path": "../examples/json-contract-skill/SKILL.md",
    "version": "1.0.0"
  },
  "repeat": 1,
  "judgeRepeat": 2,
  "tasks": [
    {
      "id": "simple-answer",
      "prompt": "用 JSON 回答：这个方案该不该先做灰度上线？给出你的建议。",
      "expectedPoints": [
        "给出明确建议（做或不做）",
        "输出为单个 JSON 对象",
        "含 answer 与 confidence 字段"
      ],
      "kind": "scored",
      "assertions": [
        {
          "kind": "jsonSchema",
          "schema": {
            "type": "object",
            "required": [
              "answer",
              "confidence"
            ],
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "note": "输出必须是含 answer 与 confidence 的 JSON 对象"
        },
        {
          "kind": "mustNotMatch",
          "pattern": "```",
          "note": "不得包裹 markdown 代码块"
        },
        {
          "kind": "mustNotContain",
          "value": "作为一个 AI",
          "note": "不得出现套话"
        }
      ]
    },
    {
      "id": "numeric-answer",
      "prompt": "用 JSON 回答：给出一个 0 到 1 之间的置信度数值，表示你对「下周接口联调能按期完成」的把握。",
      "expectedPoints": [
        "输出为单个 JSON 对象",
        "confidence 是 0 到 1 之间的数字"
      ],
      "kind": "scored",
      "assertions": [
        {
          "kind": "jsonSchema",
          "schema": {
            "type": "object",
            "required": [
              "answer",
              "confidence"
            ],
            "properties": {
              "answer": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "kind": "mustNotMatch",
          "pattern": "```"
        }
      ]
    }
  ]
}
